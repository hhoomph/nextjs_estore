# Copy to .env (local) or set in Vercel project settings.
# NEVER commit a real .env file.

# --- Database (Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Better Auth ---
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
ALLOWED_CALLBACK_URLS="http://localhost:3000/api/auth/callback,http://localhost:3000"

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
HCAPTCHA_SECRET_KEY=""

# --- Admin ---
NEXT_PUBLIC_SUPER_ADMIN_EMAILS="admin@estore.com"

# --- AI / Email / Storage (add only what you use) ---
